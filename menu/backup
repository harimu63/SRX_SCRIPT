#!/bin/bash
# ==========================================
# Backup via Telegram Bot
# Modified from email backup to Telegram
# ==========================================

# Color codes
RED='\033[0;31m'
NC='\033[0m'
GREEN='\033[0;32m'
ORANGE='\033[0;33m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
LIGHT='\033[0;37m'

# Load Telegram handler
TELEGRAM_HANDLER="/usr/local/sbin/telegram-backup-handler.sh"
if [ ! -f "$TELEGRAM_HANDLER" ]; then
    TELEGRAM_HANDLER="/root/telegram-backup.sh"
fi

if [ -f "$TELEGRAM_HANDLER" ]; then
    source "$TELEGRAM_HANDLER"
else
    echo -e "${RED}Error: Telegram handler not found!${NC}"
    echo -e "${YELLOW}Please reinstall the script or contact support.${NC}"
    exit 1
fi

clear
echo -e "${CYAN}╔════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║${LIGHT}          BACKUP DATA VIA TELEGRAM BOT          ${CYAN}║${NC}"
echo -e "${CYAN}╚════════════════════════════════════════════════╝${NC}"
echo ""

# Load Telegram configuration
if ! load_telegram_config; then
    echo ""
    echo -e "${YELLOW}Setup Telegram Bot first using 'autobackup' menu!${NC}"
    echo ""
    read -n 1 -s -r -p "Press any key to continue..."
    exit 1
fi

# Get VPS info
IP=$(curl -sS ipv4.icanhazip.com 2>/dev/null || wget -qO- ipv4.icanhazip.com 2>/dev/null || echo "Unknown")
domain=$(cat /etc/xray/domain 2>/dev/null || echo "No-Domain")
date=$(date +"%Y-%m-%d")
time=$(date +"%H:%M:%S")
backup_filename="${IP}-${date}.zip"

echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}Starting backup process...${NC}"
echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Remove old backup folder if exists
rm -rf /root/backup
mkdir -p /root/backup

echo -e "${CYAN}[1/5]${NC} Collecting system files..."
# Backup system files (same as original)
cp /etc/passwd /root/backup/ 2>/dev/null
cp /etc/group /root/backup/ 2>/dev/null
cp /etc/shadow /root/backup/ 2>/dev/null
cp /etc/gshadow /root/backup/ 2>/dev/null
cp /etc/crontab /root/backup/ 2>/dev/null
echo -e "${GREEN}      ✓ System files collected${NC}"

echo -e "${CYAN}[2/5]${NC} Collecting VPN configurations..."
# Backup VPN configs
cp -r /var/lib/kyt/ /root/backup/kyt 2>/dev/null
cp -r /etc/xray /root/backup/xray 2>/dev/null
cp -r /var/www/html/ /root/backup/html 2>/dev/null
cp -r /etc/openvpn /root/backup/openvpn 2>/dev/null
echo -e "${GREEN}      ✓ VPN configurations collected${NC}"

echo -e "${CYAN}[3/5]${NC} Creating compressed backup..."
cd /root
zip -r "$backup_filename" backup > /dev/null 2>&1

if [ ! -f "/root/$backup_filename" ]; then
    echo -e "${RED}      ✗ Failed to create backup file!${NC}"
    rm -rf /root/backup
    exit 1
fi

# Get file size
file_size=$(stat -f%z "/root/$backup_filename" 2>/dev/null || stat -c%s "/root/$backup_filename" 2>/dev/null)
file_size_mb=$(echo "scale=2; $file_size / 1024 / 1024" | bc)
echo -e "${GREEN}      ✓ Backup created (${file_size_mb}MB)${NC}"

echo -e "${CYAN}[4/5]${NC} Uploading to Telegram..."

# Prepare caption
caption="📦 <b>VPS BACKUP</b>

<b>Server Info:</b>
━━━━━━━━━━━━━━━━
🌐 IP      : <code>${IP}</code>
🔗 Domain  : <code>${domain}</code>
📅 Date    : ${date}
⏰ Time    : ${time}
💾 Size    : ${file_size_mb}MB
━━━━━━━━━━━━━━━━

✅ Backup completed successfully!
Use <b>/restore</b> menu to restore this backup."

# Upload file to Telegram
file_id=$(send_telegram_file "/root/$backup_filename" "$caption" "$BOT_TOKEN" "$CHAT_ID")

if [ $? -eq 0 ] && [ -n "$file_id" ]; then
    echo -e "${GREEN}      ✓ Upload successful!${NC}"
    echo ""
    echo -e "${CYAN}[5/5]${NC} Cleaning old backups..."
    
    # Clean old backups (keep last 3)
    clean_old_telegram_backups "$BOT_TOKEN" "$CHAT_ID" 3
    
    # Clean local files
    rm -rf /root/backup
    rm -f "/root/$backup_filename"
    
    echo ""
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${GREEN}           ✓ BACKUP COMPLETED!${NC}"
    echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "${LIGHT}Backup Details:${NC}"
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "  IP VPS       : ${GREEN}${IP}${NC}"
    echo -e "  Domain       : ${GREEN}${domain}${NC}"
    echo -e "  Backup Date  : ${GREEN}${date} ${time}${NC}"
    echo -e "  File Size    : ${GREEN}${file_size_mb}MB${NC}"
    echo -e "  File ID      : ${GREEN}${file_id}${NC}"
    echo -e "${YELLOW}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "${CYAN}📱 Backup file has been sent to your Telegram!${NC}"
    echo -e "${CYAN}📥 Check your Telegram bot to download the backup.${NC}"
    echo ""
else
    echo -e "${RED}      ✗ Upload failed!${NC}"
    echo ""
    echo -e "${YELLOW}Backup file saved locally at:${NC}"
    echo -e "${GREEN}/root/$backup_filename${NC}"
    echo ""
    echo -e "${YELLOW}You can manually upload it or check your Telegram bot configuration.${NC}"
fi

echo ""
read -n 1 -s -r -p "Press any key to continue..."
echo ""
